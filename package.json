{
  "name": "chess-board",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p src/core/tsconfig.json && tsc -p src/interaction/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "size": "node scripts/check-size.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run size",
    "lighthouse": "npx -y lighthouse@12 http://localhost:4173/ --only-categories=performance,accessibility,best-practices --view"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
